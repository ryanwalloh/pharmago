# Customer Mobile App - Environment Configuration Template
# Copy this file to .env and update with your values

# ============================================
# Backend API Configuration
# ============================================

# Railway Backend (Production/Testing)
# Use this when testing with Railway hosted backend
EXPO_PUBLIC_API_BASE=https://pharmago-backend-production.up.railway.app

# Local Backend (Development)
# Uncomment and use your computer's IP for local development
# Find your IP: ipconfig (Windows) or ifconfig (Mac/Linux)
# EXPO_PUBLIC_API_BASE=http://192.168.x.x:8000

# ============================================
# Google Maps API Configuration
# ============================================

# Google Maps API Key (Required for maps and location features)
GOOGLE_MAPS_API_KEY=AIzaSyCCuDLJMhB-23kQiXYpXwi-yYGvKz7OgSQ

# ============================================
# Usage Instructions
# ============================================

# 1. Copy this file:
#    cp env.template .env

# 2. Update EXPO_PUBLIC_API_BASE:
#    - For Railway testing: Use the provided Railway URL
#    - For local dev: Use your computer's local IP

# 3. Start the app:
#    npm start

# 4. The app will automatically use these environment variables

# ============================================
# Environment Switching
# ============================================

# Quick Switch to Local Development:
# EXPO_PUBLIC_API_BASE=http://192.168.1.10:8000

# Quick Switch to Railway:
# EXPO_PUBLIC_API_BASE=https://pharmago-backend-production.up.railway.app

# No .env file? App will use Railway by default (fallback)

